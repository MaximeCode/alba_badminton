# Ignorer le dossier node_modules
node_modules/

# Ignorer les fichiers de logs
*.log

# Ignorer les fichiers et dossiers temporaires
.DS_Store
.env
.cache/
dist/
.idea/

# Ignorer les fichiers spécifiques de WordPress
wp-content/wflogs/
wp-content/advanced-cache.php
wp-content/backup-db/
wp-content/backups/
wp-content/cache/
wp-content/languages/
wp-content/updraft/
wp-content/upgrade/
wp-content/uploads/
wp-content/debug.log

# Ignorer les plugins et thèmes non personnalisés
wp-content/plugins/*
!wp-content/plugins/sports-club-teams.php

# Ignorer les fichiers de configuration sensibles
wp-config.php
wp-config-sample.php

# Ignorer les fichiers de configuration de WordPress
wp-admin/
wp-includes/

# Ignorer le fichier style.css car il est généré automatiquement
/wp-content/themes/alba_theme/style.css