## Bloquer l’accès aux fichiers XML-RPC si vous ne les utilisez pas
#<Files xmlrpc.php>
#  Require all denied
#</Files>
#
## Empêcher la navigation dans les répertoires
#Options -Indexes
#
## Désactiver la signature du serveur Apache
#ServerSignature Off
#
## Limiter l'accès au fichier readme.html de WordPress
#<Files readme.html>
#  Require all denied
#</Files>
